<div id="<%= dom_id booking %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Vehicle:</strong>
    <%= booking.vehicle_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Customer:</strong>
    <%= booking.customer_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">From date:</strong>
    <%= booking.from_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">To date:</strong>
    <%= booking.to_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= booking.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status reason:</strong>
    <%= booking.status_reason %>
  </div>
</div>

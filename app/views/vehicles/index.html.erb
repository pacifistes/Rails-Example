<% content_for :title, "Vehicles" %>

<%= turbo_stream_from "vehicles" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Vehicles</h1>
    <%= link_to "New vehicle", new_vehicle_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <!-- Filters -->
  <%= render "filters" %>

  <!-- Vehicles section (will be replaced via Turbo Streams) -->
  <div id="vehicles-section">
    <%= render "vehicles_section", 
        vehicles_list: @vehicles, 
        current_page: @current_page, 
        total_pages: @total_pages, 
        total_count: @total_count,
        filter_params: @filter_params %>
  </div>
</div>


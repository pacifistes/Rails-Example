<%= form_with url: vehicles_path,
              method: :get,
              local: true,
              class: "bg-gray-50 p-6 rounded-lg mb-6" do |f| %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Vehicle Type Filter -->
    <%= checkbox_filter_group(:vehicle_type, Vehicle::VEHICULE_TYPES, selected_filter_values(:vehicle_type)) %>

    <!-- Brand Filter -->
    <%= checkbox_filter_group(:brand, (Car::BRANDS + Motorbike::BRANDS).uniq.sort, selected_filter_values(:brand)) %>

    <!-- Model Filter -->
    <%= checkbox_filter_group(:model, (Car::MODELS + Motorbike::MODELS).uniq.sort, selected_filter_values(:model)) %>

    <!-- Fuel Type Filter -->
    <%= checkbox_filter_group(:fuel_type, Car::FUEL_TYPES, selected_filter_values(:fuel_type)) %>

    <!-- Gearbox Filter -->
    <%= checkbox_filter_group(:gearbox, Car::GEARBOXS, selected_filter_values(:gearbox)) %>

    <!-- Price Range -->
    <div>
      <%= f.label :min_price, "Min Price", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= number_filter_field(f, :min_price, step: 0.01, min: 0, placeholder: "Min price") %>
    </div>

    <div>
      <%= f.label :max_price, "Max Price", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= number_filter_field(f, :max_price, step: 0.01, min: 0, placeholder: "Max price") %>
    </div>

    <!-- Year Range -->
    <div>
      <%= f.label :min_year, "Min Year", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= number_filter_field(f, :min_year, min: 1900, max: Date.today.year, placeholder: "Min year", step: 1) %>
    </div>

    <div>
      <%= f.label :max_year, "Max Year", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= number_filter_field(f, :max_year, min: 1900, max: Date.today.year, placeholder: "Max year", step: 1) %>
    </div>
  </div>

  <div class="mt-4 flex gap-2">
    <%= f.submit "Filter",
          name: nil,
          class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-500 font-medium" %>

    <%= link_to "Clear Filters", vehicles_path,
          class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 font-medium" %>
  </div>

<% end %>

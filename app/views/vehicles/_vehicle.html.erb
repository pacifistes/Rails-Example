<div id="<%= dom_id vehicle %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Vehicle type:</strong>
    <%= vehicle.vehicle_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= vehicle.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price by day:</strong>
    <%= vehicle.price_by_day %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Year of production:</strong>
    <%= vehicle.year_of_production %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Images:</strong>
    <% vehicle.images.each do |image| %>
      <div><%= link_to image.filename, image, class: "text-gray-700 underline hover:no-underline" %></div>
    <% end %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Added by:</strong>
    <%= vehicle.added_by_id %>
  </div>
</div>
